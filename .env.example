# Server
APP_PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080
APP_READ_TIMEOUT=10
APP_WRITE_TIMEOUT=10

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=news_db
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_HOURS=24

# S3 Storage — Biznet Gio NOS (S3-compatible)
S3_ENDPOINT=
S3_REGION=jkt
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=
S3_PUBLIC_URL=

# Scheduler Berita (in-process goroutine)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=10
SCHEDULER_MAX_CONCURRENCY=3
SCHEDULER_DEFAULT_STATUS=published
NEWS_ITEMS_PER_WEBSITE=5

# AI Rewriter (OpenAI-compatible)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=0
AI_TEMPERATURE=0.7
